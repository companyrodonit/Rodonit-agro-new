# Змінні оточення. Без них сайт працює на вбудованих статичних даних,
# а /admin недоступний.

# Postgres (Neon). На проді — база клієнта.
POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# Ключ сесій Payload. Згенерувати: openssl rand -hex 24
PAYLOAD_SECRET=

# Схема БД. Локальна розробка пише в окрему схему, прод лишає порожнім (public).
# PAYLOAD_DB_SCHEMA=redesign

# Канонічна адреса сайту (для canonical/OG/sitemap/robots).
# Без неї на Vercel береться VERCEL_PROJECT_PRODUCTION_URL.
# NEXT_PUBLIC_SITE_URL=https://rodonit.com.ua

# Vercel Blob — сховище картинок адмінки на проді (Storage → Blob → токен).
# BLOB_READ_WRITE_TOKEN=
